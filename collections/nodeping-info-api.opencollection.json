{
  "opencollection": "1.0.0",
  "info": {
    "name": "NodePing Accounts Info API",
    "version": "1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "token",
      "value": "{{token}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Info",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get probe / location information",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.nodeping.com/api/1/info"
          },
          "docs": "Get probe / location information"
        }
      ]
    }
  ],
  "bundled": true
}