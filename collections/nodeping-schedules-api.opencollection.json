{
  "opencollection": "1.0.0",
  "info": {
    "name": "NodePing Accounts Schedules API",
    "version": "1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "token",
      "value": "{{token}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Schedules",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List notification schedules",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.nodeping.com/api/1/schedules"
          },
          "docs": "List notification schedules"
        },
        {
          "info": {
            "name": "Update a schedule",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.nodeping.com/api/1/schedules"
          },
          "docs": "Update a schedule"
        },
        {
          "info": {
            "name": "Delete a schedule",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.nodeping.com/api/1/schedules"
          },
          "docs": "Delete a schedule"
        }
      ]
    }
  ],
  "bundled": true
}