{
  "opencollection": "1.0.0",
  "info": {
    "name": "NodePing Accounts Notifications API",
    "version": "1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "token",
      "value": "{{token}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Notifications",
        "type": "folder"
